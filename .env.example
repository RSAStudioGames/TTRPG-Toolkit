# Go (Fiber) app — internal listen address (Caddy proxies to this port).
TTRPG_SERVER_HOST=0.0.0.0
TTRPG_SERVER_PORT=8080

# Public HTTP port exposed by Caddy in docker compose.
CADDY_PORT=80

# PostgreSQL — full stack (docker compose up): host "postgres"
# TTRPG_DATABASE_URL=postgres://ttrpg:ttrpg@postgres:5432/ttrpg_toolkit?sslmode=disable
# DB only (docker compose -f docker-compose.db.yml up -d): localhost:43021
TTRPG_DATABASE_URL=postgres://ttrpg:ttrpg@localhost:43021/ttrpg_toolkit?sslmode=disable

# Local file storage for system images (created if missing).
TTRPG_UPLOAD_DIR=./data/uploads
